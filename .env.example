# Copie para .env.local e cole a URI completa exibida em MongoDB Atlas > Connect > Drivers.
# Exemplo: mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=printlab3d
SESSION_SECRET=

# Credenciais OAuth de cada marketplace (necessárias para conexões reais em produção).
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=https://seu-dominio.com/api/integrations/mercadoLivre/callback

SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=https://seu-dominio.com/api/integrations/shopee/callback
# Altere apenas se o console da Shopee indicar outro host para sua região.
SHOPEE_API_BASE=https://partner.shopeemobile.com

TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# Cole a URL de autorização de vendedor fornecida pelo Partner Center.
TIKTOK_SHOP_AUTH_URL=
TIKTOK_SHOP_API_BASE=https://open-api.tiktokglobalshop.com
# A versão deve acompanhar a versão habilitada para o aplicativo no Partner Center.
TIKTOK_SHOPS_PATH=/authorization/202309/shops
TIKTOK_PRODUCTS_PATH=/product/202309/products/search
TIKTOK_ORDERS_PATH=/order/202309/orders/search
